# SAP Datasphere MCP Server Configuration

# SAP Datasphere Connection
DATASPHERE_BASE_URL=https://your-tenant.eu10.hcs.cloud.sap
DATASPHERE_TENANT_ID=your-tenant-id

# OAuth 2.0 Credentials (Interactive User - Authorization Code Flow)
# Create these in your SAP BTP / SAP IAS App Integration settings
DATASPHERE_CLIENT_ID=your-client-id
DATASPHERE_CLIENT_SECRET=your-client-secret
DATASPHERE_TOKEN_URL=https://your-tenant.authentication.eu10.hana.ondemand.com/oauth/token
DATASPHERE_AUTHORIZE_URL=https://your-tenant.authentication.eu10.hana.ondemand.com/oauth/authorize

# Local callback port for browser-based login (default: 8400)
DATASPHERE_REDIRECT_PORT=8400

# OAuth Scope (defaults to "openid" if left empty)
DATASPHERE_SCOPE=openid

# Server Configuration
LOG_LEVEL=INFO
SERVER_PORT=8080

# Development Mode (set to false for production)
USE_MOCK_DATA=false
