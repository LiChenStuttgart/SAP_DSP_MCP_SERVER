# SAP Datasphere MCP Server Configuration

# SAP Datasphere Connection
DATASPHERE_BASE_URL=https://your-tenant.eu10.hcs.cloud.sap
DATASPHERE_TENANT_ID=your-tenant-id

# Authentication mode:
# - technical_user: OAuth Client Credentials (non-interactive, recommended for MCP/servers)
# - interactive: OAuth Authorization Code (opens browser + localhost callback)
# - auto: choose interactive when DATASPHERE_AUTHORIZE_URL is set, else technical_user
AUTH_MODE=technical_user

# OAuth 2.0 Credentials
# Create these in your SAP Datasphere App Integration settings
DATASPHERE_CLIENT_ID=your-client-id
DATASPHERE_CLIENT_SECRET=your-client-secret
DATASPHERE_TOKEN_URL=https://your-tenant.authentication.eu10.hana.ondemand.com/oauth/token
# Required for AUTH_MODE=interactive, optional for AUTH_MODE=technical_user
DATASPHERE_AUTHORIZE_URL=https://your-tenant.authentication.eu10.hana.ondemand.com/oauth/authorize

# Local callback port for browser-based login (AUTH_MODE=interactive)
DATASPHERE_REDIRECT_PORT=8400

# OAuth Scope (defaults to "openid" if left empty)
DATASPHERE_SCOPE=openid

# Server Configuration
LOG_LEVEL=INFO
SERVER_PORT=8080

# Development Mode (set to false for production)
USE_MOCK_DATA=false
